@{
	var currentPath = Context.Request.Path.Value ?? "/";
	var isEnglish = currentPath.Equals("/en", StringComparison.OrdinalIgnoreCase)
		|| currentPath.StartsWith("/en/", StringComparison.OrdinalIgnoreCase);
	var langPrefix = isEnglish ? "/en" : "";

	// The /en tree mirrors the German one with translated folder names; map between them
	// so the language switcher lands on the counterpart of the current page.
	var germanSegments = new[] { "Modelle", "Galerie", "Fahrer", "Rueckblick", "Autos" };
	var englishSegments = new[] { "Models", "Gallery", "Drivers", "History", "Cars" };
	String SwapSegments(String path, String[] from, String[] to)
	{
		var segments = path.Trim('/').Split('/');
		for (var i = 0; i < segments.Length; i++)
		{
			var index = Array.FindIndex(from, s => s.Equals(segments[i], StringComparison.OrdinalIgnoreCase));
			if (index >= 0)
			{
				segments[i] = to[index];
			}
		}
		return "/" + String.Join("/", segments);
	}
	var switchUrl = isEnglish
		? SwapSegments(currentPath.Substring(3), englishSegments, germanSegments)
		: ("/en" + SwapSegments(currentPath, germanSegments, englishSegments)).TrimEnd('/');
	if (String.IsNullOrEmpty(switchUrl))
	{
		switchUrl = "/";
	}

	// UseExceptionHandler rewrites the path to /Error, so there is no per-language
	// counterpart to link to — suppress the switcher and hreflang there.
	var isErrorPage = currentPath.Equals("/Error", StringComparison.OrdinalIgnoreCase)
		|| currentPath.Equals("/en/Error", StringComparison.OrdinalIgnoreCase);
	var germanUrl = isEnglish ? switchUrl : currentPath;
	var englishUrl = isEnglish ? currentPath : switchUrl;
	var siteBase = $"{Context.Request.Scheme}://{Context.Request.Host}";
}
<!DOCTYPE html>
<html lang="@(isEnglish ? "en" : "de")">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	@if (String.IsNullOrWhiteSpace((String)ViewData["Title"]))
	{
		<title>Mitsubishi Pajero</title>
	}
	else
	{
		<title>@ViewData["Title"] - Mitsubishi Pajero</title>
	}
	@if (!isErrorPage)
	{
		<link rel="alternate" hreflang="de" href="@siteBase@(germanUrl)" />
		<link rel="alternate" hreflang="en" href="@siteBase@(englishUrl)" />
		<link rel="alternate" hreflang="x-default" href="@siteBase@(germanUrl)" />
	}
	<link rel="stylesheet"
		  href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/site.css" />
	<!-- Global site tag (gtag.js) - Google Analytics -->
	<script async src="https://www.googletagmanager.com/gtag/js?id=UA-1052763-31"></script>
	<script>
		window.dataLayer = window.dataLayer || [];
		function gtag() { dataLayer.push(arguments); }
		gtag('js', new Date());

		gtag('config', 'UA-1052763-31');
	</script>
</head>
<body>
	<header>
		<nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
			<div class="container">
				<a class="navbar-brand" href="@(isEnglish ? "/en" : "/")">
					<img id="logo" src="~/images/logo.png" />
					<span>MitsubishiPajero</span>
				</a>
				<button class="navbar-toggler"
						type="button"
						data-toggle="collapse"
						data-target=".navbar-collapse"
						aria-controls="navbarSupportedContent"
						aria-expanded="false"
						aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>
				<div class="navbar-collapse collapse d-sm-inline-flex">
					<ul class="navbar-nav flex-grow-1">
						<li class="nav-item">
							<a class="nav-link text-dark"
							   href="@(isEnglish ? "/en" : "/")">
								@(isEnglish ? "The Pajero" : "Der Pajero")
							</a>
						</li>
						<li class="nav-item">
							<a class="nav-link text-dark"
							   href="@langPrefix/Mitsubishi">
								Mitsubishi
							</a>
						</li>
						<li class="nav-item">
							<a class="nav-link text-dark"
							   href="@(isEnglish ? "/en/Models" : "/Modelle")">
								@(isEnglish ? "Models" : "Modelle")
							</a>
						</li>
						<li class="nav-item">
							<a class="nav-link text-dark"
							   href="@langPrefix/Dakar">
								Dakar
							</a>
						</li>
						<li class="nav-item">
							<a class="nav-link text-dark"
							   href="@(isEnglish ? "/en/Gallery" : "/Galerie")">
								@(isEnglish ? "Gallery" : "Galerie")
							</a>
						</li>
					</ul>
					@if (!isErrorPage)
					{
						<ul class="navbar-nav">
							<li class="nav-item">
								<a class="nav-link text-dark" href="@switchUrl">
									@(isEnglish ? "Deutsch" : "English")
								</a>
							</li>
						</ul>
					}
				</div>
			</div>
		</nav>
	</header>
	<div class="container">
		<main role="main" class="pb-3">
			@RenderBody()
		</main>
	</div>

	<footer class="border-top footer text-muted">
		<div class="container">
			&copy; 2020-@DateTime.UtcNow.Year - MitsubishiPajero -
			<a href="@langPrefix/Privacy">Privacy</a>
		</div>
	</footer>

	<div>
		<div id="modalImagePanel" class="modal">
			<span id="modalClose">&times;</span>
			<img id="modalImage" class="modal-content" />
			<div id="modalCaption"></div>
		</div>
	</div>

	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>

	@RenderSection("Scripts", required: false)
</body>
</html>